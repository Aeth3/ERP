# Local machine overrides for backend development.
# Copy to .env.local and fill in only the values you want to override from .env.

DB_PASSWORD=change-me-local-db-password
JWT_SECRET=change-me-local-jwt-secret

# Optional local mail overrides
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-user
# MAIL_PASSWORD=change-me-mail-password

# Optional frontend URL override
# APP_FRONTEND_BASE_URL=http://localhost:3000
