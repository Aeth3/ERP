# backend env setup
copy .env.example .env

# optional local override
# keep machine-specific secrets in .env.local
# this file is imported by application.properties and stays untracked
# copy .env.local.example .env.local
# example:
# DB_PASSWORD=your-local-password
# JWT_SECRET=your-local-jwt-secret

# run locally with dev profile
cd ERP
./gradlew bootRun --args="--spring.profiles.active=dev"

# alternative powershell form
$env:SPRING_PROFILES_ACTIVE="dev"
.\gradlew bootRun

# dev profile notes
# loads application.properties first, then overrides with application-dev.properties
# also imports ERP/.env and ERP/.env.local if present
# requires MySQL running at localhost:3306 with database maiu_db
# seeds a default admin in dev:
# email: admin@maiu.local
# password: admin123

# database migrations
# Flyway is enabled by default
# dev keeps hibernate update for convenience
# docker/prod default to hibernate validate + Flyway migrations

# local
docker compose up -d

# safer local docker flow from workspace root
# copy ..\.env.compose.example ..\.env.compose
# docker compose --env-file ..\.env.compose -f ..\docker-compose.yml up -d

# ec2
docker compose -p remnant-life-ec2 -f docker-compose-ec2.yml up -d

# tag the image
docker tag remnant-app:latest ajdamalan/remnant-life-ec2-app:x.x.x

# push the image
docker push ajdamalan/remnant-life-ec2-app:x.x.x

# pull the image from your ec2
sudo docker pull ajdamalan/remnant-life-ec2-app:x.x.x

# run on ec2
sudo docker run -d -p 8080:8080 \
  --name remnant_app \
  -e SPRING_PROFILES_ACTIVE=prod \
  ajdamalan/remnant-life-ec2-app:x.x.x

# production compose flow from workspace root
# copy ..\.env.compose.prod.example ..\.env.compose.prod
# fill in real DB/JWT values outside git
# docker compose --env-file ..\.env.compose.prod -f ..\docker-compose-prod.yml pull
# docker compose --env-file ..\.env.compose.prod -f ..\docker-compose-prod.yml up -d

# security note
# if DB passwords or JWT secrets were ever committed, rotate them before the next deployment
# see docs/SECRET_ROTATION.md for a concrete checklist and search targets
# see docs/ENV_FILE_MAP.md for the exact per-file env split

